{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "REI",
  "version": "1.0.0",
  "identifier": "com.rei.pdfchat",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "REI — PDF Chat",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../backend/**/*",
      "../requirements.txt"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
